APP_NAME="Sudaya Coffee"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dipakai untuk link undangan dan reset password, harus alamat publik aplikasi.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Supabase Dashboard, Connect. Host pooler, bukan db.<ref>.supabase.co yang hanya IPv6:
#   postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=
# Isi true untuk Transaction pooler (port 6543). Session pooler (5432) tidak memerlukannya.
DB_EMULATE_PREPARES=false

# Token Supabase disimpan terpisah, lihat AUTH_TOKEN_CACHE_DRIVER. Sesi hanya memegang id.
SESSION_DRIVER=file
# Menit tanpa aktivitas. Perangkat outlet dipakai terus-menerus, jadi tidak dibuat pendek.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Isi true di production (HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# Store token Supabase. Terpisah dari CACHE_STORE agar `cache:clear` tidak me-logout staf.
AUTH_TOKEN_CACHE_DRIVER=file

# Server-side rendering tidak dipakai: production tanpa proses Node.
INERTIA_SSR_ENABLED=false
# Enkripsi riwayat browser butuh HTTPS atau localhost.
INERTIA_ENCRYPT_HISTORY=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Rahasia, melewati RLS. Hanya di server, tidak pernah berawalan VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL="${SUPABASE_URL}"
VITE_SUPABASE_PUBLISHABLE_KEY="${SUPABASE_PUBLISHABLE_KEY}"

# Header yang ditimpa reverse proxy tepercaya, mis. X-Real-IP. Kosong = IP tidak diketahui.
TRUSTED_IP_HEADER=

# APK Android aplikasi staf (opsional, setelah domain production ada) — lihat docs/APLIKASI_HP.md.
# Nama paket APK dan sidik jari SHA-256 sertifikat penandatangan (format AB:CD:...).
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256=
