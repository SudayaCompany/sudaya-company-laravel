# .env production Sudaya Coffee (VPS). Disalin provision.sh ke /var/www/sudaya/shared/.env.
# Isi bagian bertanda WAJIB, lalu: sudo sudaya-artisan sudaya:doctor
# File ini contoh tanpa rahasia. .env asli JANGAN di-commit dan jangan dikirim lewat chat.

APP_NAME="Sudaya Coffee"
APP_ENV=production
APP_DEBUG=false
# Diisi otomatis oleh provision.sh. Mengganti kunci ini me-logout semua staf.
APP_KEY=
# WAJIB: alamat publik dengan https, dipakai untuk link undangan dan reset password.
APP_URL=https://__DOMAIN__

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# WAJIB: Supabase Dashboard → Connect → Session pooler (port 5432), region Singapura.
#   postgresql://postgres.<ref>:<password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Password yang mengandung karakter khusus (@ : / ? #) wajib di-URL-encode.
DB_URL=
DB_EMULATE_PREPARES=false

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
AUTH_TOKEN_CACHE_DRIVER=file

INERTIA_SSR_ENABLED=false
INERTIA_ENCRYPT_HISTORY=true

# Laravel tidak mengirim email: undangan dan reset password dikirim Supabase Auth.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# WAJIB: Supabase Dashboard → Settings → API (project production yang SAMA dengan DB_URL).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Rahasia, melewati RLS. Hanya di server ini.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL="${SUPABASE_URL}"
VITE_SUPABASE_PUBLISHABLE_KEY="${SUPABASE_PUBLISHABLE_KEY}"

# Nginx (deploy/nginx/sudaya.conf) menimpa header ini dengan IP asli pengunjung.
TRUSTED_IP_HEADER=X-Real-IP

# Backup harian 02.30 WIB (php artisan sudaya:backup, disimpan 14 hari).
BACKUP_DIR=/var/backups/sudaya

# Opsional: APK Android aplikasi staf (docs/APLIKASI_HP.md).
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256=
