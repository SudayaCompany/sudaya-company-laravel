<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test ke Supabase dev sungguhan (DB_URL dan kunci dari .env). Jangan arahkan ke
  database production. Jalankan: php artisan test -c phpunit.live.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="default"
>
    <testsuites>
        <testsuite name="Live">
            <directory>tests/Live</directory>
        </testsuite>
        <testsuite name="E2E">
            <directory>tests/E2E</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Sama dengan server E2E, agar test bisa memeriksa store token yang dipakai server. -->
        <env name="AUTH_TOKEN_CACHE_DRIVER" value="file"/>
    </php>
</phpunit>
